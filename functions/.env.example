# Copy to functions/.env (not committed) and fill in. These are settings, not
# secrets: the Stripe secret key and webhook signing secret are stored with
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Your website's address, exactly as customers open it (no trailing slash).
APP_ORIGIN=https://your-domain.com

# Stripe Price IDs (Stripe Dashboard → Product catalog → your product → Pricing).
# Leave a plan empty to hide it.
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=

# true once Stripe Tax is set up (adds VAT/sales tax at checkout).
STRIPE_AUTOMATIC_TAX=false

# ---- Project files and backups (Google Drive) — see docs/DRIVE_FILES.md ----
# The ID of the SHARED drive (or a folder inside one) that holds every
# project's folder: the last part of its address,
# https://drive.google.com/drive/folders/<this part>
# Leave empty to switch project files off.
DRIVE_ROOT_FOLDER_ID=
# File space per project, in MB (default 2048).
DRIVE_PROJECT_QUOTA_MB=2048
# File space one account may add across all its projects, in MB (default 10240).
DRIVE_USER_QUOTA_MB=10240
