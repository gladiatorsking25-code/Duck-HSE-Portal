// firestore.rules — the real, server-enforced security boundary.
// Publish from Firebase Console → Firestore Database → Rules, or
//   firebase deploy --only firestore:rules
//
// What these enforce:
//   1. A user only ever reads/writes their own data (users/{uid}/...).
//   2. PAID and ADMIN entitlement (an active/comped subscription, an expiry, an
//      admin grant, or the admin role) is NEVER client-writable — only the Cloud
//      Functions (Admin SDK) or a verified Play purchase can set those.
//   3. EXCEPTION: a signed-in user may start their own FREE TRIAL once, with the
//      end date bounded to ~the trial length, and delete is forbidden — so nobody
//      can extend or reset it. This lets trials work without Cloud Functions
//      (free Spark plan); paid subscriptions still require server verification.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Paid + admin state — never client-writable.
    function protectedKeys() {
      return ['role', 'subscriptionId', 'subscriptionExpiryMillis',
              'subscriptionUpdatedAt', 'adminGrantUntil', 'compForever'];
    }
    // The only fields a client may set for a one-time free trial.
    function trialKeys() {
      return ['subscriptionStatus', 'trialStartedAt', 'trialEndsAt'];
    }
    // Every entitlement field (paid + admin + trial), for the "plain profile" test.
    function allEntitlementKeys() {
      return ['role', 'subscriptionId', 'subscriptionExpiryMillis',
              'subscriptionUpdatedAt', 'adminGrantUntil', 'compForever',
              'subscriptionStatus', 'trialStartedAt', 'trialEndsAt'];
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // A valid one-time trial payload: status exactly 'trial' and an end date no
    // more than ~15 days out (bounds a 14-day trial + a little clock slack).
    function trialWindowOk() {
      return request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.trialEndsAt is number
        && request.resource.data.trialEndsAt > request.time.toMillis()
        && request.resource.data.trialEndsAt <= request.time.toMillis() + 1296000000;
    }

    match /users/{uid} {
      allow get:  if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Create: a plain profile doc (no entitlement fields at all), OR a one-time
      // trial doc holding only the trial fields.
      allow create: if isOwner(uid) && (
             !request.resource.data.keys().hasAny(allEntitlementKeys())
          || ( request.resource.data.keys().hasOnly(trialKeys()) && trialWindowOk() )
      );

      // Update: touches neither paid/admin nor trial fields, OR a one-time trial
      // bootstrap on an account that has no trial yet.
      allow update: if isOwner(uid) && (
             ( !changed().hasAny(protectedKeys()) && !changed().hasAny(trialKeys()) )
          || ( !('trialEndsAt' in resource.data)
               && changed().hasOnly(trialKeys())
               && trialWindowOk() )
      );

      allow delete: if false;

      match /assessments/{docId} { allow read, write: if isOwner(uid); }
      match /permits/{docId}     { allow read, write: if isOwner(uid); }
      match /checklists/{docId}  { allow read, write: if isOwner(uid); }
    }

    // Written only by Cloud Functions (Admin SDK); no client access.
    match /purchaseTokens/{token} { allow read, write: if false; }
    match /adminLog/{id}          { allow read: if isAdmin(); allow write: if false; }

    // Explicit default-deny for everything else.
    match /{document=**} { allow read, write: if false; }
  }
}
