# .htaccess — Apache / LiteSpeed settings for hosting on Hostinger.
# Upload the CONTENTS of public/ to public_html/. Nothing outside public/ is
# meant to be served.

Options -Indexes
DirectoryIndex index.html

# ---- One address, always HTTPS --------------------------------------------
# The site answers on one address only. Sign-in, the records kept on the
# device and the offline copy all belong to one address, so a visitor on
# www.<your-domain> is sent to <your-domain>. APP_ORIGIN in functions/.env must
# be that same address (docs/DEPLOY.md, step 4).
# To use the www. address instead (only if the site is on a bare domain such
# as example.com, not on a subdomain such as hse.example.com), replace the
# first RewriteCond/RewriteRule pair below with:
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Never serve dotfiles, docs, keys or backups --------------------------
# (Defence in depth: none of these should be in public/ in the first place.)
<FilesMatch "(^\.|\.(md|txt|env|pem|key|p12|jks|keystore|bak|zip|log|mjs|ps1|cmd|lock|yaml|yml)$|^(package|package-lock|firebase|twa-manifest|service-account.*|google-services)\.json$)">
  Require all denied
</FilesMatch>

# ---- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Content-Security-Policy. Pages still use inline <script> blocks and inline
  # event handlers, so 'unsafe-inline' is needed for now; everything else is
  # restricted to this site and the Google/Firebase services the app calls.
  # localhost ports are the optional on-device AI model servers (js/hse-ai.js).
  # blob: in frame-src and media-src lets the audit viewer (js/audit-viewer.js)
  # preview PDF, video and audio evidence. That is safe only because the viewer
  # types every file from its name and never shows a web page or SVG this way.
  # The service worker downloads the Firebase SDK and Google Fonts itself, and
  # its downloads are checked against connect-src, so those hosts are there too.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://www.gstatic.com https://fonts.gstatic.com https://accounts.google.com http://localhost:11434 http://localhost:1234 http://127.0.0.1:11434 http://127.0.0.1:1234; frame-src blob: https://accounts.google.com https://docs.google.com https://drive.google.com https://*.firebaseapp.com; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  # HTML, CSS, JavaScript (the service worker too) and the manifest are checked
  # with the server on every load. That is cheap when nothing changed, and a
  # new upload is never mixed with last week's scripts. The offline copy comes
  # from the service worker, not from this.
  <FilesMatch "\.(html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images and fonts rarely change and may be kept for a week. When two blocks
  # match a file, the later one wins, so no script or page may match this one.
  <FilesMatch "\.(png|jpe?g|webp|gif|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
</IfModule>
